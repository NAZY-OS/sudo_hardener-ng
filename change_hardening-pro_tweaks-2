#!/bin/sh

# Script: sudo-hardening-pro_tweaks
# Author: [NAZY-OS]
# Description: [Applies or reverts PAM and sudoers configuration changes for security hardening.]
# Version: 2.1 RC
# License: MIT License



# =============================================
# Security Hardening Script for PAM and Sudo
# =============================================

# Check root privileges
[ "$(id -u)" -ne 0 ] && { echo "Error: Must be run as root" >&2; exit 1; }

# =============================================
# Display help message
# =============================================
show_help() {
    echo "Usage: $0 {apply|revert|--help}"
    echo
    echo "Commands:"
    echo "  apply   Apply the security hardening changes."
    echo "  revert  Revert the security hardening changes."
    echo "  --help  Display this help message."
}

# =============================================
# Create backup copies of configuration files
# =============================================
create_backups() {
    cp /etc/pam.d/su /etc/pam.d/su.bak 2>/dev/null
    cp /etc/pam.d/sudo /etc/pam.d/sudo.bak 2>/dev/null
    cp /etc/sudoers /etc/sudoers.bak 2>/dev/null
    [ -d /etc/sudoers.d ] && cp /etc/sudoers.d/g_wheel /etc/sudoers.d/g_wheel.bak 2>/dev/null
}

# =============================================
# Configure PAM settings for sudo and su
# =============================================
configure_pam() {
    # sudo PAM configuration with faillock protection
    cat >/etc/pam.d/sudo <<'EOF'
# PAM configuration for sudo
# Enforces account lockout after multiple failed attempts

auth       required     pam_faillock.so preauth silent deny=8 unlock_time=1500
auth       [success=1 default=ignore] pam_unix.so
auth       required     pam_faillock.so authfail deny=8 unlock_time=1500
auth       required     pam_wheel.so use_uid

account    required     pam_faillock.so
account    required     pam_unix.so

session    required     pam_limits.so
session    required     pam_unix.so
EOF

    # su PAM configuration (compatible with sudo)
    cat >/etc/pam.d/su <<'EOF'
# PAM configuration for su
# Enforces account lockout after multiple failed attempts

auth       required     pam_faillock.so preauth silent deny=8 unlock_time=1500
auth       [success=1 default=ignore] pam_unix.so
auth       required     pam_faillock.so authfail deny=8 unlock_time=1500
auth       required     pam_wheel.so use_uid

account    required     pam_faillock.so
account    required     pam_unix.so

session    required     pam_limits.so
session    required     pam_unix.so
EOF
}

# =============================================
# Configure sudoers file and directory
# =============================================
configure_sudoers() {
    # Ensure sudoers.d directory exists
    [ -d /etc/sudoers.d ] || mkdir -p /etc/sudoers.d

    # Create g_wheel file if it doesn't exist
    [ -f /etc/sudoers.d/g_wheel ] || touch /etc/sudoers.d/g_wheel

    # Add wheel group sudo privileges
    echo '%wheel ALL=(ALL) ALL' >/etc/sudoers.d/g_wheel

    # Add sudo defaults if not present
    grep -q pwfeedback /etc/sudoers 2>/dev/null || \
    printf '\nDefaults env_reset,pwfeedback,timestamp_timeout=10,passwd_timeout=0,insults' >>/etc/sudoers
}

# =============================================
# Revert all changes using backup files
# =============================================
revert_changes() {
    [ -f /etc/pam.d/su.bak ] && cp /etc/pam.d/su.bak /etc/pam.d/su
    [ -f /etc/pam.d/sudo.bak ] && cp /etc/pam.d/sudo.bak /etc/pam.d/sudo
    [ -f /etc/sudoers.bak ] && cp /etc/sudoers.bak /etc/sudoers
    [ -f /etc/sudoers.d/g_wheel.bak ] && cp /etc/sudoers.d/g_wheel.bak /etc/sudoers.d/g_wheel
}

# =============================================
# Main execution flow
# =============================================
case "$1" in
    apply)
        create_backups
        configure_pam
        configure_sudoers
        echo "Security hardening applied successfully."
        ;;
    revert)
        revert_changes
        echo "Security hardening reverted successfully."
        ;;
    --help|-h|help)
        show_help
        ;;
    *)
        echo "Error: Unknown command '$1'" >&2
        show_help
        exit 1
        ;;
esac
